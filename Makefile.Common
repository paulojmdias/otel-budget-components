# Shared targets for every Go module in this repository. Component Makefiles
# include it (`include ../../Makefile.Common`), like contrib does, so
# `make test` or `make lint` works inside a component directory.
SHELL     := /bin/bash
GO        ?= go
REPO_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
BIN       := $(REPO_ROOT)/bin

MDATAGEN         := $(BIN)/mdatagen
SCHEMAGEN        := $(BIN)/schemagen
BUILDER          := $(BIN)/builder
GOLANGCI_LINT    := $(BIN)/golangci-lint
GOLANGCI_VERSION ?= v2.14.0

$(MDATAGEN) $(SCHEMAGEN) $(BUILDER):
	cd $(REPO_ROOT)/internal/tools && $(GO) build -o $(BIN)/mdatagen go.opentelemetry.io/collector/cmd/mdatagen
	cd $(REPO_ROOT)/internal/tools && $(GO) build -o $(BIN)/schemagen go.opentelemetry.io/collector/cmd/schemagen
	cd $(REPO_ROOT)/internal/tools && $(GO) build -o $(BIN)/builder go.opentelemetry.io/collector/cmd/builder

$(GOLANGCI_LINT):
	GOBIN=$(BIN) $(GO) install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$(GOLANGCI_VERSION)

.PHONY: tools
tools: $(MDATAGEN) $(SCHEMAGEN) $(BUILDER) $(GOLANGCI_LINT)

# mdatagen and config.schema.yaml, for directories with a metadata.yaml
.PHONY: generate
generate: $(MDATAGEN) $(SCHEMAGEN)
	@if [ -f metadata.yaml ]; then $(MDATAGEN) metadata.yaml && $(SCHEMAGEN) .; fi

.PHONY: lint
lint: $(GOLANGCI_LINT)
	$(GOLANGCI_LINT) run --config $(REPO_ROOT)/.golangci.yml ./...

.PHONY: test
test:
	$(GO) test -race ./...

.PHONY: cover
cover:
	$(GO) test -race -coverprofile=coverage.out ./...
	$(GO) tool cover -func=coverage.out | tail -1

.PHONY: bench
bench:
	$(GO) test -run '^$$' -bench . -benchmem ./...

.PHONY: tidy
tidy:
	$(GO) mod tidy
